        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "23"
      },
      {
        "_action": {
          "_location": {
            "_key": "SPAWN_DREAMER_HALBERD"
          },
          "$type": "OutwardArchipelago.Graphs.Actions.Action_CompleteLocationCheck"
        },
        "_position": {
          "x": 4380.0,
          "y": 5970.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "25"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Where will you go now?",
              "_meta": "Neutral_SQ_Immaculate_29"
            }
          }
        ],
        "_position": {
          "x": 4365.0,
          "y": 6105.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "28"
      },
      {
        "_action": {
          "Sound": "LOC_EXCL_Immac03",
          "TransPos": {},
          "$type": "NodeCanvas.Tasks.Actions.PlaySound"
        },
        "_position": {
          "x": 4395.0,
          "y": 6255.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "32"
      },
      {
        "statement": {
          "_text": "Wherever I desire. Perhaps we will cross paths again someday. May you stay safe and grow strong, friendly human. The world could use more like you.",
          "_audio": "CS_Immaculate_HeavyHurt_Grunt2",
          "_meta": "Neutral_SQ_Immaculate_30"
        },
        "_actorName": "Immaculate",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4215.0,
          "y": 6345.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "35"
      },
      {
        "_position": {
          "x": 4260.0,
          "y": 6495.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "37"
      },
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "esrjYN5-c0m8keOg90Y3_w"
          },
          "_invert": true,
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 4950.0,
          "y": 5790.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "38"
      },
      {
        "_action": {
          "Sound": "LOC_EXCL_Immac05",
          "TransPos": {},
          "$type": "NodeCanvas.Tasks.Actions.PlaySound"
        },
        "_position": {
          "x": 4830.0,
          "y": 5925.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "41"
      },
      {
        "statement": {
          "_text": "The sea breeze in the Chersonese always fills me with the urge to travel. It’s just a pity that winter is so unbearably cold.",
          "_audio": "CS_Immaculate_HeavyHurt_Grunt2",
          "_meta": "Neutral_SQ_Immaculate_01"
        },
        "_actorName": "name_unpc_immaculate_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4755.0,
          "y": 6090.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "44"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "You're a monster from the Scourge! An Immaculate!",
              "_meta": "Neutral_SQ_Immaculate_06"
            }
          },
          {
            "statement": {
              "_text": "Who are you?",
              "_meta": "Neutral_SQ_Immaculate_07"
            }
          },
          {
            "statement": {
              "_text": "Can you help me?",
              "_meta": "Neutral_SQ_Immaculate_08"
            },
            "condition": {
              "QuestEventRef": {
                "m_eventUID": "esrjYN5-c0m8keOg90Y3_w"
              },
              "_invert": true,
              "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
            }
          },
          {
            "statement": {
              "_text": "Thank you for the chat, I’ll be off.",
              "_meta": "Neutral_SQ_Immaculate_31"
            }
          }
        ],
        "_position": {
          "x": 5040.0,
          "y": 6450.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "46"
      },
      {
        "statement": {
          "_text": "And? The circumstances of my creation are no one’s concern but my own. What I am, is alive. It is not my fault that those who bear the spirit of the enemy stirs in me an instinctual rage. I avoid contact with them for this very reason. I wish no one any harm.",
          "_meta": "Neutral_SQ_Immaculate_09"
        },
        "_actorName": "Immaculate",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4185.0,
          "y": 6825.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "58"
      },
      {
        "_targetNode": {
          "$ref": "46"
        },
        "_position": {
          "x": 4335.0,
          "y": 7080.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "60"
      },
      {
        "statement": {
          "_text": "I sense there is more to that question.",
          "_meta": "Neutral_SQ_Immaculate_23"
        },
        "_actorName": "Immaculate",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4695.0,
          "y": 6945.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "61"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "What’s your name?",
              "_meta": "Neutral_SQ_Immaculate_24"
            }
          },
          {
            "statement": {
              "_text": "What are you doing here?",
              "_meta": "Neutral_SQ_Immaculate_25"
            }
          },
          {
            "statement": {
              "_text": "You seem to enjoy reading a lot.",
              "_meta": "Neutral_SQ_Immaculate_26"
            }
          },
          {
            "statement": {
              "_text": "Nothing",
              "_meta": "Merchant_Generic_Nothing_01"
            }
          }
        ],
        "_position": {
          "x": 4455.0,
          "y": 7200.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "63"
      },
      {
        "statement": {
          "_text": "Names are a human thing. My kind can tell one another apart without such arbitrary nonsense. We only call ourselves Immaculates because that's what your kind calls us.",
          "_meta": "Neutral_SQ_Immaculate_10"
        },
        "_actorName": "Immaculate",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3855.0,
          "y": 7440.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "73"
      },
      {
        "_targetNode": {
          "$ref": "63"
        },
        "_position": {
          "x": 4005.0,
          "y": 7590.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "75"
      },
      {
        "statement": {
          "_text": "I am on a journey. I want to learn, I want to grow, I want to see all that this world has to offer. I would like to be free of these instinctual shackles. If I never had to harm another person or beast, again...I would be very content.",
          "_meta": "Neutral_SQ_Immaculate_27"
        },
        "_actorName": "Immaculate",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4125.0,
          "y": 7515.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "76"
      },
      {
        "_targetNode": {
          "$ref": "63"
        },
        "_position": {
          "x": 4200.0,
          "y": 7710.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "78"
      },
      {
        "statement": {
          "_text": "Yes. The knowledge from humans long since gone is quite valuable. And the way your kind makes fake history, \"stories\", for the purpose of amusement...It's a comfort to me on the lonely road I walk.",
          "_meta": "Neutral_SQ_Immaculate_28"
        },
        "_actorName": "Immaculate",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4245.0,
          "y": 7620.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "79"
      },
      {
        "_targetNode": {
          "$ref": "63"
        },
        "_position": {
          "x": 4335.0,
          "y": 7860.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "81"
      },
      {
        "statement": {
          "_text": "Is something else on your mind, human?",
          "_meta": "Neutral_SQ_Immaculate_22"
        },
        "_actorName": "Immaculate",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4425.0,
          "y": 7740.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "82"
      },
      {
        "_targetNode": {
          "$ref": "46"
        },
        "_position": {
          "x": 4530.0,
          "y": 7845.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "84"
      },
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "vyd636V_RE-RqTzBdB3vYg"
          },
          "MinStack": 2,
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 5145.0,
          "y": 6825.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "85"
      },
      {
        "statement": {
          "_text": "If your life depends on it, I will help you. But I worry if I will be able to complete my journey at this rate.",
          "_meta": "Neutral_SQ_Immaculate_21"
        },
        "_actorName": "name_unpc_immaculate_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4815.0,
