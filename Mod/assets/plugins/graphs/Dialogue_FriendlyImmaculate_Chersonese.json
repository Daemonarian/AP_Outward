        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "111"
      },
      {
        "statement": {
          "_text": "I don't posses much but, I can offer you a piece of my survival gear. What need drives you?",
          "_meta": "Neutral_SQ_Immaculate_11"
        },
        "_actorName": "name_unpc_immaculate_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
