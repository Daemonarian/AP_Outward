      },
      {
        "statement": {
          "_text": "My journey has been a little tougher lately. But I can still provide aid to you if you need it.",
          "_meta": "Neutral_SQ_Immaculate_20"
        },
        "_actorName": "name_unpc_immaculate_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 5190.0,
