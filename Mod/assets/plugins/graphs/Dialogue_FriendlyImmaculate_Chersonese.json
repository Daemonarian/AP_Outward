        "$id": "20"
      },
      {
        "statement": {
          "_text": "It's been interesting to meet you again and again like this on my journey. Here, I made this for you. It's a halberd that my kind uses, one that I have made safe for human hands. May it protect you from whatever means you harm.",
          "_audio": "CS_Immaculate_HeavyHurt_Grunt2",
          "_meta": "Neutral_SQ_Immaculate_19"
        },
        "_actorName": "name_unpc_immaculate_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4305.0,
