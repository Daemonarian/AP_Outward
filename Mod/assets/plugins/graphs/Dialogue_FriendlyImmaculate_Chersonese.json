        "$id": "113"
      },
      {
        "$ref": "17"
      },
      {
        "statement": {
          "_text": "I hope our paths cross again on my journey. Having friendly company brightens my day.",
          "_meta": "Neutral_SQ_Immaculate_05"
        },
