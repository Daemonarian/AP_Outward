        "$id": "59"
      },
      {
        "statement": {
          "_text": "I can’t believe Levant would dare attack the Blue Chamber. In the middle of a council meeting, no less!",
          "_meta": "Cyrill_HM_Doubts_04"
        },
        "_actorName": "name_unpc_cyril_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4320.0,
          "y": 3390.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "62"
      },
      {
        "_targetNode": {
          "$ref": "8"
        },
        "_position": {
          "x": 4425.0,
          "y": 3615.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "64"
      },
      {
        "statement": {
          "_text": "Today really makes me nervous... Such immense shifts in the status quo are never good for business. I just hope our Headmaster knows what he’s doing…",
          "_meta": "Cyrill_Turnbull_BC_Mix_Legacy_01"
        },
        "_actorName": "name_unpc_cyril_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4890.0,
          "y": 3375.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "65"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "I thought Soroboreans were supposed to have absolute faith in their leadership?",
              "_meta": "Player_Cyrill_Turnbull_BC_Mix_Legacy_a_01"
            }
          },
          {
            "statement": {
              "_text": "Well, given the work you have to do to get that position, I’m sure he does.",
              "_meta": "Player_Cyrill_Turnbull_BC_Mix_Legacy_b_01"
            }
          },
          {
            "statement": {
              "_text": "I want to train with you.",
              "_meta": "Merchant_Generic_Train_01"
            },
            "condition": {
              "character": {
                "_name": "gInstigator",
                "_targetVariableID": "0483cf6b-da62-4a57-aaed-40f25b4bdf9b"
              },
              "skill": {
                "_value": 1
              },
              "_invert": true,
              "$type": "NodeCanvas.Tasks.Conditions.Condition_KnowSkill"
            }
          }
        ],
        "_position": {
          "x": 4965.0,
          "y": 3480.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "67"
      },
      {
        "statement": {
          "_text": "Well... Yes. We’re supposed to. But we’re only human.",
          "_meta": "Cyrill_Turnbull_BC_Mix_Legacy_02"
        },
        "_actorName": "name_unpc_cyril_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4710.0,
          "y": 3765.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "78"
      },
      {
        "_position": {
          "x": 5025.0,
          "y": 3915.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "80"
      },
