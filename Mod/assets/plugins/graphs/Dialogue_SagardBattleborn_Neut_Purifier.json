    "nodes": [
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "q--_LPc6JEeCyRUjVQSgAA"
          },
          "MinStack": 3,
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 6090.0,
          "y": 6330.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "2"
      },
      {
        "statement": {
          "_text": "Well, well, well. Look at that. I'll handle this investigation personally and see that justice comes down hard on everyone involved. They need to be made an example of!",
          "_meta": "Sagard_Purifier_02"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "1b375fde-5a79-4f43-b8bb-a7a640f84a86",
        "_position": {
          "x": 5865.0,
          "y": 6480.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "5"
      },
      {
        "statement": {
          "_text": "Hand me the evidence and I’ll give you 50 Silver and my sincere assurance that the perpetrator will pay dearly for this. This could be a great political gift. I’d seriously owe you for this.",
          "_meta": "Sagard_Purifier_03"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "1b375fde-5a79-4f43-b8bb-a7a640f84a86",
        "_position": {
          "x": 5835.0,
          "y": 6615.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "7"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Let me think more about this.",
              "_meta": "Player_Cyrill_Purifier_a_04"
            }
          },
          {
            "statement": {
              "_text": "Deal. Take the evidence.",
              "_meta": "Player_Jager_Purifier_b_04"
            }
          },
          {
            "statement": {
              "_text": "I want to train with you.",
              "_meta": "Merchant_Generic_Train_01"
            },
            "condition": {
              "_location": {
                "_key": "TRAIN_SAGARD_BATTLEBORN"
              },
              "_invert": true,
              "$type": "OutwardArchipelago.Graphs.Conditions.Condition_LocationCheck"
            }
          }
        ],
        "_position": {
          "x": 5940.0,
          "y": 6720.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "9"
      },
      {
        "statement": {
          "_text": "I don’t know who you think will get the job done better than me, but alright. As long as justice is done here, I’m satisfied.",
          "_meta": "Sagard_Purifier_04"
        },
        "_actorName": "SagardBattleborn",
        "_actorParameterID": "1b375fde-5a79-4f43-b8bb-a7a640f84a86",
        "_position": {
          "x": 5625.0,
          "y": 6915.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "19"
