        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "34"
      },
      {
        "statement": {
          "_text": "Perfect. I’m going to enjoy bringing down the hammer on Sorobor for this. I owe you one, [PlayerName], and Sagard Battleborn always honors his debts",
          "_meta": "Sagard_Purifier_05"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "1b375fde-5a79-4f43-b8bb-a7a640f84a86",
        "_position": {
          "x": 5985.0,
          "y": 7455.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "39"
      },
      {
        "_position": {
          "x": 6105.0,
          "y": 7605.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "41"
      },
      {
        "_action": {
          "QuestEventRef": {
            "m_eventUID": "qRludSuL80abynZ8MjOVkg"
          },
          "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
        },
        "_position": {
          "x": 6270.0,
          "y": 7095.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "42"
      },
      {
        "_targetNode": {
          "statement": {
            "_text": "If you pay me, sure, I’ll give you a private lesson. You wanna know the most effective way to finish off a opponent with a 2-handed axe once you’ve got them on the floor? Pay my tab for tonight, about 50 silver, and I’ll teach you.",
            "_meta": "Trainer_Micro_Finisher_01"
          },
          "_actorName": "name_unpc_sagardbattleborn_01 ",
          "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
          "_position": {
            "x": 6780.0,
            "y": 7155.0
          },
          "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
          "$id": "46"
        },
        "_position": {
          "x": 6450.0,
          "y": 6930.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "45"
      },
      {
        "statement": {
          "_text": "Unless you have big news or we’re under attack or you’re here to drink with me, I don’t think I have much to say to you. Free time is hard to come by for a Chamberlord of such a big city and intend to enjoy every moment I can snatch.",
          "_meta": "Sagard_BC_Prequest_07"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "1b375fde-5a79-4f43-b8bb-a7a640f84a86",
        "_position": {
          "x": 6405.0,
          "y": 6495.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "48"
      },
      {
        "_position": {
          "x": 6465.0,
          "y": 6660.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "50"
      },
      {
        "$ref": "46"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Deal, here’s your money.",
              "_meta": "Merchant_Generic_Pay_01"
            },
            "condition": {
              "character": {
                "_name": "gInstigator",
                "_targetVariableID": "67059ca8-8b6e-4cb0-a0fb-bd765e41e725"
              },
              "item": {
                "_value": {
                  "m_itemID": 9000010
                }
              },
              "minAmount": {
                "_value": 50
              },
              "itemMustBeEquiped": {},
              "$type": "NodeCanvas.Tasks.Conditions.Condition_OwnsItem"
            }
          },
          {
            "statement": {
              "_text": "No, thanks.",
              "_meta": "Merchant_Generic_No_02"
            }
          }
        ],
        "_position": {
          "x": 6810.0,
          "y": 7290.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "51"
      },
      {
        "statement": {
          "_text": "Alright, come with me. We’re going to go practice this on a couple of old logs. Here, I’ll even let you use my-",
          "_meta": "Trainer_Micro_Finisher_02"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
