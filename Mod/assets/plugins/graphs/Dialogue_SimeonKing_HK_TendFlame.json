        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "55"
      },
      {
        "statement": {
          "_text": "-And if they don’t fall for it, jab really quick at their shoulder height. You have no idea how often that catches people by surprise!",
          "_meta": "Trainer_Micro_DeflectionStrike_03"
        },
        "_actorName": "name_unpc_simeon_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
