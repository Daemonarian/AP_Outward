        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "17"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Farewell.",
              "_meta": "Merchant_Generic_Farewell_01"
            }
          },
          {
            "statement": {
              "_text": "I want to train with you.",
              "_meta": "Merchant_Generic_Train_01"
            }
          }
        ],
        "_position": {
          "x": 4425.0,
          "y": 4575.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "18"
      },
      {
        "_position": {
          "x": 4320.0,
          "y": 4830.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "24"
      },
      {
        "statement": {
          "_text": "Hah, you want to learn from the best? Buy me a couple rounds at the inn, say about 50 silvers worth, and I’ll teach you the Deflection Strike. It’s a spear technique that’s both defensive and offensive that’s saved me several times.",
          "_meta": "Trainer_Micro_DeflectionStrike_01"
        },
        "_actorName": "name_unpc_simeon_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4470.0,
          "y": 4800.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "25"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Deal, here’s your money.",
              "_meta": "Merchant_Generic_Pay_01"
            },
            "condition": {
              "character": {
                "_name": "gInstigator",
                "_targetVariableID": "0483cf6b-da62-4a57-aaed-40f25b4bdf9b"
              },
              "item": {
                "_value": {
                  "m_itemID": 9000010
                }
              },
              "minAmount": {
