              },
              "itemMustBeEquiped": {},
              "$type": "NodeCanvas.Tasks.Conditions.Condition_OwnsItem"
            }
          },
          {
            "statement": {
              "_text": "No, thanks.",
              "_meta": "Merchant_Generic_No_02"
            }
          }
        ],
        "_position": {
          "x": 4515.0,
          "y": 4950.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "27"
      },
      {
        "statement": {
          "_text": "Step outside and I’ll show you. First, you begin by baiting your foe with a low stance and prepare to counter it with a-",
          "_meta": "Trainer_Micro_DeflectionStrike_02"
        },
        "_actorName": "name_unpc_simeon_01",
