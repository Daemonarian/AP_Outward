        "$id": "47"
      },
      {
        "statement": {
          "_text": "[PlayerName]! It’s good to see you! I almost didn’t make it to Berg in one piece. Some metal golem dog things nearly got me! If a passing hunter hadn’t saved me...Hoooh.",
          "_meta": "Roland_BC_Prequest_16"
        },
        "_actorName": "name_unpc_rolandargenson_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 2895.0,
          "y": 4605.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "56"
      },
      {
        "_action": {
          "actions": [
            {
              "_location": {
                "_key": "ROLAND_GIFT_2"
              },
              "$type": "OutwardArchipelago.Graphs.Actions.Action_CompleteLocationCheck"
            },
            {
              "QuestEventRef": {
                "m_eventUID": "UtAMLtS7aEOJHreBwtyazg"
              },
              "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
            },
            {
              "QuestEventRef": {
                "m_eventUID": "8lbz0Jh_iUuDS4wpX_-vog"
              },
              "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
            }
          ],
          "$type": "NodeCanvas.Framework.ActionList"
        },
        "_position": {
          "x": 2048.0,
          "y": 3284.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "58"
      },
      {
        "statement": {
          "_text": "He gave me some stuff to make traps and told me to use them, and my brain if I’m not good at fighting. But I’d rather try to get good at fighting than rely on using these tricky things. I nearly impaled myself last time I tried arming one.",
          "_meta": "Roland_BC_Prequest_17"
        },
        "_actorName": "name_unpc_rolandargenson_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 2835.0,
          "y": 4920.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "67"
      },
      {
        "_targetNode": {
          "availableChoices": [
            {
              "statement": {
                "_text": "Thanks, Roland.",
                "_meta": "Player_Roland_BC_Prequest_a_14"
              }
            },
            {
              "statement": {
                "_text": "You should look after yourself Roland, keep it.",
                "_meta": "Player_Roland_BC_Prequest_b_14"
              }
            }
          ],
          "_position": {
            "x": 3690.0,
            "y": 5430.0
          },
          "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
          "$id": "70"
        },
