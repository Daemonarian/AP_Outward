      {
        "_position": {
          "x": 3720.0,
          "y": 5775.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "99"
      },
      {
        "statement": {
          "_text": "No. I insist. Take it. I want to make up for the shipwreck I got you caught in.",
          "_meta": "Roland_BC_Prequest_18"
        },
        "_actorName": "name_unpc_rolandargenson_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3825.0,
          "y": 5580.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "100"
      },
      {
        "statement": {
          "_text": "Oh! [PlayerName]! I found this on a hunter’s corpse not too far out from town. It’s still got his blood on it, but...It’s still usable!",
          "_meta": "Roland_BC_Prequest_14"
        },
        "_actorName": "name_unpc_rolandargenson_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3765.0,
          "y": 5130.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "102"
      },
      {
        "_action": {
          "actions": [
            {
              "_location": {
                "_key": "ROLAND_GIFT_3"
              },
              "$type": "OutwardArchipelago.Graphs.Actions.Action_CompleteLocationCheck"
            },
            {
              "QuestEventRef": {
                "m_eventUID": "T8rJOQ5Ra0qfV2vyBCXffw"
              },
              "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
            },
            {
              "QuestEventRef": {
                "m_eventUID": "8lbz0Jh_iUuDS4wpX_-vog"
              },
              "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
            }
          ],
          "$type": "NodeCanvas.Framework.ActionList"
        },
        "_position": {
          "x": 2048.0,
          "y": 3284.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "104"
      },
      {
        "statement": {
          "_text": "I’m getting better day by day...It’s still hopeless, but at least I can survive like this, even if it’s just barely. I’ll keep trying to make it up to you, [PlayerName], I promise.",
          "_meta": "Roland_BC_Prequest_13"
        },
