        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "85"
      },
      {
        "statement": {
          "_text": "I stumbled on a small cache of gems the other day. I know this should go to my Blood Price Payment, but...You lost your home because of me. I think you need this more than me. Go on, take it.",
          "_meta": "Roland_BC_Prequest_15"
        },
        "_actorName": "name_unpc_rolandargenson_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3300.0,
          "y": 5130.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "88"
      },
