        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "67"
      },
      {
        "_action": {
          "$type": "NodeCanvas.Tasks.Actions.FadeIn"
        },
        "_position": {
          "x": 5625.0,
          "y": 4845.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "79"
      },
      {
        "statement": {
          "_text": "Hah, there you go, you’ve gotten the hang of it! Remember, while you turn for extra momentum, you should step forward and put your full weight into it!",
          "_meta": "Trainer_Micro_Finisher_03"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
