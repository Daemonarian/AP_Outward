      },
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "AA0VyQO--kqZFB2KLzx71Q"
          },
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 4095.0,
          "y": 3645.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "9"
      },
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "nCba7dxUxkGdji2vWNlUbg"
          },
          "MinStack": 2,
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 4035.0,
          "y": 3855.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "12"
      },
      {
        "statement": {
          "_text": "Hah! I knew it! Levant has finally made their last mistake!",
          "_meta": "Sagard_BC_Mix_Legacy_03"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3945.0,
          "y": 4050.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "15"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "How can you even be sure that Levant did this?",
              "_meta": "Player_Sagard_BC_Mix_Legacy_a_03"
            }
          },
          {
            "statement": {
              "_text": "I look forward to our revenge too, sir!",
              "_meta": "Player_Sagard_BC_Mix_Legacy_b_03"
            }
          }
        ],
        "_position": {
          "x": 3990.0,
          "y": 4185.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "17"
      },
      {
        "statement": {
          "_text": "Amateur! The only ambassador they killed was the one from Old Levant, the one person who could have overturned their kingdom! They used firearms too!",
          "_meta": "Sagard_BC_Mix_Legacy_04"
        },
        "_actorName": "Sagard Battleborn",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3645.0,
          "y": 4320.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "23"
      },
      {
        "statement": {
          "_text": "Now is not the time to debate the obvious. We gather our troops and strike NOW, before they strike us again! They likely have their whole army on the road for Berg as we speak!",
          "_meta": "Sagard_BC_Mix_Legacy_05"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3705.0,
          "y": 4440.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "25"
      },
      {
        "_position": {
          "x": 3960.0,
          "y": 4620.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "27"
      },
      {
        "statement": {
          "_text": "Finally, someone who speaks my language! Everyone else is giving me toddler-speak about \"waiting until we know for certain\". These spineless politicians will get us all killed!",
          "_meta": "Sagard_BC_Mix_Legacy_06"
        },
        "_actorName": "Sagard Battleborn",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4110.0,
          "y": 4335.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "28"
      },
      {
        "_action": {
          "QuestEventRef": {
            "m_eventUID": "zEXapCH7p0uoaoBgIX9Y_A"
          },
          "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
        },
        "_position": {
          "x": 4485.0,
          "y": 3990.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "30"
      },
      {
        "statement": {
          "_text": "This meeting is a waste of time. Why drag all the Chamberlords here over two issues that really don’t matter? We should be discussing strategies to defend ourselves from Levant!",
          "_meta": "Sagard_BC_Mix_Legacy_01"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4530.0,
          "y": 4065.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "33"
      },
      {
        "statement": {
          "_text": "Then again... If Old Levant’s claim is recognized, that might solve the issue entirely. At least they believe in the order and structure of the Blue Chamber’s Laws. I'd trust them over those sand rats, Calixa and Simeon any day.",
          "_meta": "Sagard_BC_Mix_Legacy_02"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4560.0,
          "y": 4230.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "35"
      },
      {
        "_position": {
          "x": 4710.0,
          "y": 4380.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "37"
      },
      {
        "statement": {
          "_text": "Move along. I have combat strategies to prepare for when those desert rats in Levant inevitably come after us. It’s only a matter of time before they get too big for their bloomers and try to take what isn’t theirs.",
          "_meta": "Sagard_BC_Prequest_06"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4800.0,
          "y": 3780.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "38"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Farewell.",
              "_meta": "Merchant_Generic_Farewell_01"
            }
          },
          {
            "statement": {
              "_text": "I want to train with you.",
              "_meta": "Merchant_Generic_Train_01"
            },
            "condition": {
              "_location": {
                "_key": "TRAIN_SAGARD_BATTLEBORN"
              },
              "_invert": true,
              "$type": "OutwardArchipelago.Graphs.Conditions.Condition_LocationCheck"
            }
          }
        ],
        "_position": {
          "x": 5385.0,
          "y": 3900.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "40"
      },
      {
        "_position": {
          "x": 5055.0,
          "y": 4140.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "48"
      },
      {
        "statement": {
          "_text": "If you pay me, sure, I’ll give you a private lesson. You wanna know the most effective way to finish off a opponent with a 2-handed axe once you’ve got them on the floor? Pay my tab for tonight, about 50 silver, and I’ll teach you.",
          "_meta": "Trainer_Micro_Finisher_01"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 5700.0,
          "y": 4185.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "49"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Deal, here’s your money.",
              "_meta": "Merchant_Generic_Pay_01"
            },
            "condition": {
              "character": {
                "_name": "gInstigator",
                "_targetVariableID": "0483cf6b-da62-4a57-aaed-40f25b4bdf9b"
              },
              "item": {
                "_value": {
                  "m_itemID": 9000010
                }
              },
              "minAmount": {
                "_value": 50
              },
              "itemMustBeEquiped": {},
              "$type": "NodeCanvas.Tasks.Conditions.Condition_OwnsItem"
            }
          },
          {
            "statement": {
              "_text": "No, thanks.",
              "_meta": "Merchant_Generic_No_02"
            }
          }
        ],
        "_position": {
          "x": 5730.0,
          "y": 4320.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "51"
      },
      {
        "statement": {
          "_text": "Alright, come with me. We’re going to go practice this on a couple of old logs. Here, I’ll even let you use my-",
          "_meta": "Trainer_Micro_Finisher_02"
        },
        "_actorName": "name_unpc_sagardbattleborn_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 5475.0,
          "y": 4500.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "63"
      },
