        "$id": "110"
      },
      {
        "statement": {
          "_text": "Come back when you have <color=#00CCFF><b>Quest License 2</b></color>.",
          "_meta": "com.daemonarium.apoutward.dialogue.naturalist_dean.quest_license_2_required"
        },
        "_actorName": "name_unpc_ericakasper_01",
        "_position": {
