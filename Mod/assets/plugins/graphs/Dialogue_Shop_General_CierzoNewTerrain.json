    "nodes": [
      {
        "statement": {
          "_text": "Business is slow for me whenever that Soroborean caravan comes in. Let me know if anything I have catches your eye!",
          "_meta": "Merchant_Cierzo_GeneralStore_01"
        },
        "_actorName": "General Store",
        "_actorParameterID": "c5474f61-b6dd-4fba-b619-f779585e03c2",
