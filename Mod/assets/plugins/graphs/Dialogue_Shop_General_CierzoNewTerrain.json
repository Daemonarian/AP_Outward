        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "34"
      },
      {
        "statement": {
          "_text": "Be sure to come back sometime, these deliveries are needed pretty regularly.",
          "_meta": "Merchant_Cierzo_GeneralStore_03"
        },
        "_actorName": "name_merchant_cierzogeneralstore_01",
        "_actorParameterID": "c5474f61-b6dd-4fba-b619-f779585e03c2",
        "_position": {
          "x": 5955.0,
          "y": 6030.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "37"
      },
      {
        "_position": {
          "x": 6105.0,
          "y": 6225.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "39"
      },
      {
        "statement": {
          "_text": "Are you planning to pass by Berg sometime soon? I have this ledger I need delivered to the general store there. You'll be paid, of course, on delivery. It won't even weight you down at all, I promise.",
          "_meta": "Merchant_Cierzo_GeneralStore_04"
        },
        "_actorName": "name_merchant_cierzogeneralstore_01",
        "_actorParameterID": "c5474f61-b6dd-4fba-b619-f779585e03c2",
        "_position": {
          "x": 6405.0,
          "y": 6030.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "40"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Yes.",
              "_meta": "Merchant_Generic_Yes_01"
            }
          },
          {
            "statement": {
              "_text": "No.",
              "_meta": "Merchant_Generic_No_01"
            }
          }
        ],
        "_position": {
