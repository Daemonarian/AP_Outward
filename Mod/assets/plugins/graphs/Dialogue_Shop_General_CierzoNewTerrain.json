        "$id": "28"
      },
      {
        "statement": {
          "_text": "Perfect, I was waiting for this. Here, your pay for a delivery well done.",
          "_meta": "Merchant_Cierzo_GeneralStore_02"
        },
        "_actorName": "name_merchant_cierzogeneralstore_01",
        "_actorParameterID": "c5474f61-b6dd-4fba-b619-f779585e03c2",
        "_position": {
