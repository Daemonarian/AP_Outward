        "$id": "2"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "I want to buy something.",
              "_meta": "Merchant_Generic_Shop_01"
            }
          },
          {
            "statement": {
              "_text": "I’d like to talk.",
              "_meta": "Merchant_Generic_Talk_01"
            }
          },
          {
            "statement": {
              "_text": "Not now.",
              "_meta": "Merchant_Generic_NotNow_01"
            }
          },
          {
            "statement": {
              "_text": "Can you teach me about crafting and managing my inventory?",
              "_meta": "Player_craft_tutorial_a_00"
