        "$id": "15"
      },
      {
        "statement": {
          "_text": "Do not take my idol from this place! I thank you for saving it from the clutches of that vile beast, and I would reward you handsomely if you returned it to my altar within this place. ",
          "_meta": "Enmerkar_SQ_RedLich_01"
        },
        "_actorName": "name_unpc_RedLichIdol_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3525.0,
          "y": 4350.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "18"
      },
      {
        "statement": {
          "_text": "Do not sell it to that man above. He would see to its destruction! Return it to the altar to which it belongs, and I will reward you far greater than that man ever could!",
          "_meta": "Enmerkar_SQ_RedLich_02"
        },
        "_actorName": "name_unpc_RedLichIdol_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3525.0,
          "y": 4485.0
        },
