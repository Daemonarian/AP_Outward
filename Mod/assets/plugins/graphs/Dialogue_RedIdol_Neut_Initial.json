        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "29"
      },
      {
        "statement": {
          "_text": "I thank you mortal, for returning my likeness to its rightful place. My children will hear me much louder and clearer thanks to your efforts. In return, I grant you this dagger. May it be your shining moon in nights to come. ",
          "_meta": "Enmerkar_SQ_RedLich_03"
        },
        "_actorName": "name_unpc_RedLichIdol_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4425.0,
          "y": 3885.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "41"
      },
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "nllwi4FnR0qN7968EsJ07A"
          },
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 4410.0,
          "y": 3975.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "43"
      },
      {
        "statement": {
          "_text": "Say...You share the Aberdeen’s bloodline, do you not? Perhaps we should become more...Acquainted. It would benefit us both greatly.",
          "_meta": "Enmerkar_SQ_RedLich_04"
        },
        "_actorName": "name_unpc_RedLichIdol_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4260.0,
          "y": 4110.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "46"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "I’ve read enough books to know this is a bad idea. No thank you!",
              "_meta": "Player_ Enmerkar_SQ_RedLich_a04"
            }
          }
        ],
        "_position": {
          "x": 4335.0,
          "y": 4245.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "48"
      },
      {
        "statement": {
          "_text": "Very well. I cannot force you. Regardless of your decision, I thank you. May you never be my enemy, Aberdeen. I have too many already.",
          "_meta": "Enmerkar_SQ_RedLich_05"
        },
        "_actorName": "name_unpc_RedLichIdol_01",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
