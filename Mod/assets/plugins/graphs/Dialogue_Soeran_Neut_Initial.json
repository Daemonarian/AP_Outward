        },
        "_actorName": "name_unpc_soeran_01 ",
        "_actorParameterID": "1b375fde-5a79-4f43-b8bb-a7a640f84a86",
        "_position": {
          "x": 5385.0,
          "y": 7170.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "21"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Deal, here’s your money.",
