          },
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 2970.0,
          "y": 3255.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "18"
      },
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "grSVcJ1mFkOqghOAleUm7g"
          },
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 2595.0,
          "y": 3375.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "21"
      },
      {
        "statement": {
          "_text": "I don’t know if I’ll ever get used to this. Having Calixa speak to me like this is...Beyond strange.",
          "_meta": "Simeon_HM_HaPeace_08"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 2280.0,
          "y": 3495.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "24"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "What happened with Calixa? How is she doing?",
              "_meta": "Player_Simeon_HK_HeroPeace_a_11"
            }
          }
        ],
        "_position": {
          "x": 2295.0,
          "y": 3645.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "26"
      },
      {
        "statement": {
          "_text": "I’m...Adjusting. I won’t lie, this is a bizarre state of existence. I’m not sure I’ll ever get used to it. Still, I persist. It’s an improvement over death.",
          "_meta": "Calixia_HK_HeroPeace_10"
        },
        "_actorName": "name_unpc_calixa_01 ",
        "_actorParameterID": "a82efdb8-82dd-4ea2-807f-9269c4c94af6",
        "_position": {
          "x": 2235.0,
          "y": 3780.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "30"
      },
      {
        "statement": {
          "_text": "It’s strange to have her present in my mind like this, but I’m sure we’ll make it work. She’s already blessed me with great power. I feel like she’s always watching my back now.",
          "_meta": "Simeon_HK_HeroPeace_12"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 2250.0,
          "y": 3915.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "32"
      },
      {
        "_position": {
          "x": 2685.0,
          "y": 4080.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "34"
      },
      {
        "statement": {
          "_text": "Can we get on with this already? My wife’s life is hanging in the balance!",
          "_meta": "Simeon_HM_HaPeace_07"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 2715.0,
          "y": 3570.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "35"
      },
      {
        "statement": {
          "_text": "We’ll be along as soon as we can. The moment Levant is stable enough to leave, we’ll be on our way.",
          "_meta": "Simeon_HM_HaPeace_04"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3075.0,
          "y": 3465.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "37"
      },
      {
        "_targetNode": {
          "statement": {
            "_text": "I'll organize a convoy to Monsoon immediately. [PlayerName], I need you to <color=#00CCFF><b>come to Monsoon</b></color> as swiftly as possible.",
            "_meta": "Simeon_HK_HeroPeace_09"
          },
          "_actorName": "name_unpc_simeon_01 ",
          "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
          "_position": {
            "x": 3045.0,
            "y": 4965.0
          },
          "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
          "$id": "40"
        },
        "_position": {
          "x": 3225.0,
          "y": 3585.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "39"
      },
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "wwfkTyWcbUqQJsNRGzVzbA"
          },
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 3540.0,
          "y": 3555.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "42"
      },
      {
        "_action": {
          "Stop": {},
          "Music": {
            "_value": "BGM_EventDramatic"
          },
          "$type": "NodeCanvas.Tasks.Actions.StartMusicEvent"
        },
        "_position": {
          "x": 3435.0,
          "y": 3630.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "45"
      },
      {
        "statement": {
          "_text": "...Gah...Elatt damn it all. Am I really so vulnerable without my wife to watch my back? Having to have my kingdom be saved by one of Elatt’s people...It’s beyond embarrassing.",
          "_meta": "Simeon_HM_HaPeace_01"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3270.0,
          "y": 3720.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "49"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Are you going to make it, sire?",
              "_meta": "Player_Simeon_HM_HaPeace_a_01"
            }
          }
        ],
        "_position": {
          "x": 3330.0,
          "y": 3855.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "51"
      },
      {
        "statement": {
          "_text": "Forget me, a few flesh wounds and a concussion are barely enough to slow me down! Calixa’s the one who needs help. Cyrene shot her with something, I think she said it was poisoned!",
          "_meta": "Simeon_HM_HaPeace_02"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3195.0,
          "y": 3975.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "55"
      },
      {
        "_action": {
          "QuestEventRef": {
            "m_eventUID": "cVdrRZnp5UuBiTUw2G25Yw"
          },
          "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
        },
        "_position": {
          "x": 3225.0,
          "y": 4065.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "57"
      },
      {
        "statement": {
          "_text": "(Elatt's fury erupts as potent as a volcano within you, then suddenly becomes calm. Elatt speaks to you and Simeon in your minds)",
          "_audio": "SFX_IMPACT_FireHeavy",
          "_meta": "Elatt_HM_HaPeace_07"
        },
        "_actorName": "name_unpc_narrator",
        "_actorParameterID": "60e03856-95ff-41d4-b612-3575b1da3c5e",
        "_position": {
          "x": 3150.0,
          "y": 4155.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "60"
      },
      {
        "statement": {
          "_text": "Simeon, <color=#00CCFF><b>bring Calixa to Monsoon</b></color>. I know of a way to save her life. Bring her to me, and accept terms of peace, and I will see to it that her life is saved. Until then, I will use what strength I can spare to keep her alive.",
          "_meta": "Elatt_HM_HaPeace_08"
        },
        "_actorName": "name_unpc_elatt_01 ",
        "_actorParameterID": "fd579054-f405-4e9b-9cc6-a48e523b7272",
        "_position": {
          "x": 3135.0,
          "y": 4275.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "62"
      },
      {
        "statement": {
          "_text": "[PlayerName], return to Monsoon with all possible haste. We must have a strong front ready to oversee negotiations between these foolish nations. Nothing must be left to chance.",
          "_meta": "Elatt_HM_HaPeace_09"
        },
        "_actorName": "name_unpc_elatt_01 ",
        "_actorParameterID": "fd579054-f405-4e9b-9cc6-a48e523b7272",
        "_position": {
          "x": 3030.0,
          "y": 4380.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "64"
      },
      {
        "_action": {
          "QuestEventRef": {
            "m_eventUID": "cVdrRZnp5UuBiTUw2G25Yw"
          },
          "RemoveAllStack": true,
          "$type": "NodeCanvas.Tasks.Actions.RemoveQuestEvent"
        },
        "_position": {
          "x": 3030.0,
          "y": 4500.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "66"
      },
      {
        "statement": {
          "_text": "...That was Elatt, wasn't it? He makes a very compelling argument. Fine, <color=#00CCFF><b>we'll set off for Monsoon as soon as humanly possible</b></color>. But he'd better hold up his end of the deal!",
          "_meta": "Simeon_HM_HaPeace_03"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 2985.0,
          "y": 4605.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "69"
      },
      {
        "_action": {
          "$type": "NodeCanvas.Tasks.Actions.FadeOut"
        },
        "_position": {
          "x": 3180.0,
          "y": 4740.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "71"
      },
      {
        "_action": {
          "actions": [
            {
              "QuestEventRef": {
                "m_eventUID": "Bsp9QbG_GEKj1JflhTu1eQ"
              },
              "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
            },
            {
              "QuestEventRef": {
                "m_eventUID": "Oi8AiwiyfUaMe2eSwtrO_w"
              },
              "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
            }
          ],
          "$type": "NodeCanvas.Framework.ActionList"
        },
        "_position": {
          "x": 3105.0,
          "y": 4815.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "73"
      },
      {
        "_action": {
          "$type": "NodeCanvas.Tasks.Actions.FadeIn"
        },
        "_position": {
          "x": 3210.0,
          "y": 4890.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "80"
      },
      {
        "$ref": "40"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "I’ll come with you on the convoy.",
              "_meta": "Player_Simeon_HK_HeroPeace_a_09"
            }
          },
          {
            "statement": {
              "_text": "I have something to do first. I’ll make my own way to Monsoon. I’ll meet you there.",
              "_meta": "Player_Simeon_HK_HeroPeace_b_09"
            }
          }
        ],
        "_position": {
          "x": 3045.0,
          "y": 5130.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "82"
      },
      {
        "_action": {
          "QuestEventRef": {
            "m_eventUID": "fJSdc0sL90GdXz39AHFl5A"
          },
          "RemoveAllStack": true,
          "$type": "NodeCanvas.Tasks.Actions.RemoveQuestEvent"
        },
        "_position": {
          "x": 2775.0,
          "y": 5235.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "88"
      },
      {
        "_action": {
          "Area": {
            "_value": "Monsoon"
          },
          "SpawnPoint": {},
          "$type": "NodeCanvas.Tasks.Actions.AreaSwitchPlayers"
        },
        "_position": {
          "x": 2850.0,
          "y": 5340.0
        },
        "$type": "NodeCanvas.DialogueTrees.ActionNode",
        "$id": "91"
      },
      {
        "_position": {
          "x": 3180.0,
          "y": 5490.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "95"
      },
      {
        "statement": {
          "_text": "Fine. But <color=#00CCFF><b>come to Monsoon as swiftly as possible</b></color>. The longer we wait, the worse it will be for us.",
          "_meta": "Simeon_HK_HeroPeace_10"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 3180.0,
          "y": 5295.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "96"
      },
      {
        "statement": {
          "_text": "(Simeon is injured, but alive)",
          "_meta": "Simeon_HK_HeroPeace_18"
        },
        "_actorName": "name_unpc_narrator",
        "_actorParameterID": "60e03856-95ff-41d4-b612-3575b1da3c5e",
        "_position": {
          "x": 3735.0,
          "y": 3750.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "98"
      },
      {
        "_position": {
          "x": 3720.0,
          "y": 4080.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "100"
      },
      {
        "_condition": {
          "QuestEventRef": {
            "m_eventUID": "rl1_bi9s4kyV5bV9UeW7eg"
          },
          "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
        },
        "_position": {
          "x": 4665.0,
          "y": 3180.0
        },
        "$type": "NodeCanvas.DialogueTrees.ConditionNode",
        "$id": "101"
      },
      {
        "statement": {
          "_text": "Ah! The latest Champion of the Holy Mission! I’d welcome you with drinks and invite you to swap stories, but things are not doing so well in the Heroic Kingdom.",
          "_meta": "Simeon_HM_HaPeace_05"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4575.0,
          "y": 3390.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "104"
      },
      {
        "statement": {
          "_text": "I’m afraid I do not have time for you. We’re juggling a famine and a losing war. Perhaps I’ll have time when things quiet down again.",
          "_meta": "Simeon_HM_HaPeace_06"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 4905.0,
          "y": 3540.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "106"
      },
      {
        "_targetNode": {
          "$ref": "9"
        },
        "_position": {
          "x": 5115.0,
          "y": 3675.0
        },
        "$type": "NodeCanvas.DialogueTrees.GoToNode",
        "$id": "108"
      },
      {
        "$ref": "9"
      },
      {
        "_position": {
          "x": 5520.0,
          "y": 3075.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "109"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Farewell.",
              "_meta": "Merchant_Generic_Farewell_01"
            }
          },
          {
            "statement": {
              "_text": "I want to train with you.",
              "_meta": "Merchant_Generic_Train_01"
            }
          }
        ],
        "_position": {
          "x": 5700.0,
          "y": 3075.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "110"
      },
      {
        "_position": {
          "x": 5580.0,
          "y": 3345.0
        },
        "$type": "NodeCanvas.DialogueTrees.FinishNode",
        "$id": "116"
      },
      {
        "statement": {
          "_text": "Hah, you want to learn from the best? Buy me a couple rounds at the inn, say about 50 silvers worth, and I’ll teach you the Deflection Strike. It’s a spear technique that’s both defensive and offensive that’s saved me several times.",
          "_meta": "Trainer_Micro_DeflectionStrike_01"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 5745.0,
          "y": 3315.0
        },
        "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
        "$id": "117"
      },
      {
        "availableChoices": [
          {
            "statement": {
              "_text": "Deal, here’s your money.",
              "_meta": "Merchant_Generic_Pay_01"
            },
            "condition": {
              "character": {
                "_name": "gInstigator",
                "_targetVariableID": "0483cf6b-da62-4a57-aaed-40f25b4bdf9b"
              },
              "item": {
                "_value": {
                  "m_itemID": 9000010
                }
              },
              "minAmount": {
                "_value": 50
              },
              "itemMustBeEquiped": {},
              "$type": "NodeCanvas.Tasks.Conditions.Condition_OwnsItem"
            }
          },
          {
            "statement": {
              "_text": "No, thanks.",
              "_meta": "Merchant_Generic_No_02"
            }
          }
        ],
        "_position": {
          "x": 5790.0,
          "y": 3465.0
        },
        "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
        "$id": "119"
      },
      {
        "statement": {
          "_text": "Step outside and I’ll show you. First, you begin by baiting your foe with a low stance and prepare to counter it with a-",
          "_meta": "Trainer_Micro_DeflectionStrike_02"
        },
        "_actorName": "name_unpc_simeon_01 ",
        "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
        "_position": {
          "x": 5580.0,
          "y": 3630.0
        },
