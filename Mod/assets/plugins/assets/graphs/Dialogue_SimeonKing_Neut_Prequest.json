            },
            "$type": "NodeCanvas.DialogueTrees.ConditionNode",
            "$id": "2"
        },
        {
            "statement": {
                "_text": "Ah, so you must be the new one we\u2019ve been informed about. Welcome to the Heroic Kingdom of Levant.",
                "_meta": "Calixia_KL_prequest_10"
            },
            "_actorName": "name_unpc_calixa_01 ",
            "_actorParameterID": "2c5c6178-69de-49c0-b3e9-a601ab8dc213",
            "_position": {
                "x": 3795.0,
                "y": 3720.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "5"
        },
        {
            "statement": {
                "_text": "I am King Simeon, and this is my Queen, Calixa. My gut tells me that your skillset seems to lie in survival. I\u2019m sure that you\u2019d be a great asset if you lent us your talents as a mercenary.",
                "_meta": "Calixia_KL_prequest_02"
            },
            "_actorName": "name_unpc_simeon_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3705.0,
                "y": 3825.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "7"
        },
        {
            "statement": {
                "_text": "We are constantly under threat by the beasts and bandits of the desert, and are facing a problem with overpopulation. If you believe you can help us, then we would be overjoyed to have you.",
                "_meta": "Calixia_KL_prequest_03"
            },
            "_actorName": "name_unpc_simeon_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3660.0,
                "y": 3930.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "9"
        },
        {
            "statement": {
                "_text": "Will you, [PlayerName], pledge your service to the ideals of the Heroic Kingdom of Levant? To help us create a place where humankind can do more than just survive?",
                "_meta": "Calixia_KL_prequest_04"
            },
            "_actorName": "name_unpc_calixa_01 ",
            "_actorParameterID": "2c5c6178-69de-49c0-b3e9-a601ab8dc213",
            "_position": {
                "x": 3660.0,
                "y": 4035.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "11"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "I don\u2019t think I\u2019m the right person for this. Sorry.",
                        "_meta": "Player_Calixia_KL_prequest_a_04"
                    }
                },
                {
                    "statement": {
                        "_text": "I pledge myself to the Heroic Kingdom.",
                        "_meta": "Player_Calixia_KL_prequest_B_04"
                    }
                }
            ],
            "_position": {
                "x": 3660.0,
                "y": 4200.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "13"
        },
        {
            "statement": {
                "_text": "That\u2019s a shame. If you change your mind, the kingdom will be waiting.",
                "_meta": "Calixia_KL_prequest_06"
            },
            "_actorName": "name_unpc_simeon_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3330.0,
                "y": 4425.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "19"
        },
        {
