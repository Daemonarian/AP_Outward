            "$id": "21"
        },
        {
            "statement": {
                "_text": "(This is a turning point in my life... <color=#00CCFF><b>Am I certain I wish to pledge my life to the Heroic Kingdom of Levant</b></color>?)",
                "_meta": "Calixia_KL_prequest_07"
            },
            "_position": {
                "x": 3855.0,
                "y": 4350.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "25"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "I don\u2019t think I\u2019m the right person for this. Sorry.",
                        "_meta": "Player_Calixia_KL_prequest_a_04"
                    }
                },
                {
                    "statement": {
                        "_text": "I pledge myself to the Heroic Kingdom.",
                        "_meta": "Player_Calixia_KL_prequest_B_04"
                    }
