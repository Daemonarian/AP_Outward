            "$id": "76"
        },
        {
            "statement": {
                "_text": "Hah, you want to learn from the best? Buy me a couple rounds at the inn, say about 50 silvers worth, and I\u2019ll teach you the Deflection Strike. It\u2019s a spear technique that\u2019s both defensive and offensive that\u2019s saved me several times.",
                "_meta": "Trainer_Micro_DeflectionStrike_01"
            },
            "_actorName": "name_unpc_simeon_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 5160.0,
                "y": 4320.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "77"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "Deal, here\u2019s your money.",
                        "_meta": "Merchant_Generic_Pay_01"
                    },
                    "condition": {
                        "character": {
                            "_name": "gInstigator",
                            "_targetVariableID": "0483cf6b-da62-4a57-aaed-40f25b4bdf9b"
                        },
                        "item": {
                            "_value": {
                                "m_itemID": 9000010
                            }
                        },
                        "minAmount": {
                            "_value": 50
                        },
                        "itemMustBeEquiped": {},
                        "$type": "NodeCanvas.Tasks.Conditions.Condition_OwnsItem"
                    }
                },
                {
                    "statement": {
                        "_text": "No, thanks.",
                        "_meta": "Merchant_Generic_No_02"
                    }
                }
            ],
            "_position": {
                "x": 5205.0,
                "y": 4485.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "79"
        },
