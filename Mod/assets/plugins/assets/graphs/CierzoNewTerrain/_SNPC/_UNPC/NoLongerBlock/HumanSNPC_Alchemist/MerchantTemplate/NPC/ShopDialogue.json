            "$id": "128"
        },
        {
            "statement": {
                "_text": "I could wax poetic about it all day. What\u2019s got your curiosity?",
                "_meta": "Wizard_tutorial_01"
            },
            "_actorName": "name_merchant_cierzoalchemist_01 ",
            "_actorParameterID": "e592641c-683d-4d8f-9c5c-768a2a7d1497",
            "_position": {
                "x": 6885.0,
                "y": 5280.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "129"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "What actually is Mana, and how do you control it?",
                        "_meta": "Player_wizard_tutorial_a_01"
                    }
                },
                {
                    "statement": {
                        "_text": "Where can I learn magic?",
                        "_meta": "Player_wizard_tutorial_a_02"
                    },
                    "condition": {
                        "character": {
                            "_name": "gInstigator",
                            "_targetVariableID": "3a601c20-be18-4c6c-8460-357b1bcd1ab3"
                        },
                        "skill": {
                            "_value": 2
                        },
                        "_invert": true,
                        "$type": "NodeCanvas.Tasks.Conditions.Condition_KnowSkill"
                    }
                }
            ],
            "_position": {
                "x": 7065.0,
                "y": 5460.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "131"
        },
        {
            "statement": {
                "_text": "Mana is energy that flows through everything. Plants, animals, people, even rocks sometimes. Mages are those who\u2019ve learned how to capture that energy unleash it in the form of magic spells.",
                "_meta": "Wizard_tutorial_02"
            },
            "_actorName": "name_merchant_cierzoalchemist_01 ",
            "_actorParameterID": "e592641c-683d-4d8f-9c5c-768a2a7d1497",
            "_position": {
                "x": 6735.0,
                "y": 5820.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "140"
        },
        {
            "statement": {
                "_text": "Magic is something that requires patience to master. By combining spells in the right sequence, you will achieve much greater results than using a spell on its own.",
                "_meta": "Wizard_tutorial_03"
            },
            "_actorName": "name_merchant_cierzoalchemist_01 ",
            "_actorParameterID": "e592641c-683d-4d8f-9c5c-768a2a7d1497",
            "_position": {
                "x": 6780.0,
                "y": 5985.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "142"
        },
        {
            "_targetNode": {
                "$ref": "75"
            },
            "_position": {
                "x": 7155.0,
                "y": 6300.0
            },
            "$type": "NodeCanvas.DialogueTrees.GoToNode",
            "$id": "144"
        },
        {
            "_condition": {
                "quest": {
                    "_value": 3
                },
                "$type": "NodeCanvas.Tasks.Conditions.Condition_KnowQuest"
            },
            "_position": {
                "x": 7380.0,
                "y": 5670.0
            },
            "$type": "NodeCanvas.DialogueTrees.ConditionNode",
            "$id": "145"
        },
        {
            "statement": {
                "_text": "To unlock the power of Mana, you must travel to a Ley Line, a place where Aurai's life flows strong. The nearest one is the one under the Conflux Mountain. You know it, right? The large purple mountain in the Chersonese. ",
                "_meta": "Wizard_tutorial_04"
            },
            "_actorName": "name_merchant_cierzoalchemist_01 ",
            "_actorParameterID": "e592641c-683d-4d8f-9c5c-768a2a7d1497",
            "_position": {
                "x": 7275.0,
                "y": 5910.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "148"
        },
        {
            "statement": {
                "_text": "The Holy Mission and the Kingdom of Levant have their own paths into the Conflux Mountain as well, and each one will test you differently. Take the path that you feel best meets your capability, or your sense of personal loyalty.",
                "_meta": "Wizard_tutorial_05"
            },
            "_actorName": "name_merchant_cierzoalchemist_01 ",
            "_actorParameterID": "e592641c-683d-4d8f-9c5c-768a2a7d1497",
            "_position": {
                "x": 7305.0,
                "y": 6060.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "150"
        },
