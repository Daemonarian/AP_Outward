        {
            "statement": {
                "_text": "Hello there. I\u2019m just mentoring this smith. He\u2019s good at what he does, but a little help from me will push him on to greatness.",
                "_meta": "Taleron_NEUT_Initial_01"
            },
            "_actorName": "name_unpc_taleron_01 ",
