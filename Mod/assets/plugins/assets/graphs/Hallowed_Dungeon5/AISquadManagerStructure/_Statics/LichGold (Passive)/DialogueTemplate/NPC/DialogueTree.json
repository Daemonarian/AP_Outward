            "_position": {
                "x": 4702.0,
                "y": 5898.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "89"
        },
        {
            "_action": {
                "_location": {
                    "_key": "SKILL_GOLDEN_WATCHER"
                },
                "$type": "OutwardArchipelago.Graphs.Actions.Action_CompleteLocationCheck"
            },
            "_position": {
                "x": 4835.0,
                "y": 6018.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "96"
        },
        {
            "_action": {
                "actions": [
                    {
                        "_location": {
                            "_key": "QUEST_MINOR_BEWARE_THE_GOLD_LICH_1"
                        },
                        "$type": "OutwardArchipelago.Graphs.Actions.Action_CompleteLocationCheck"
                    },
                    {
                        "_location": {
                            "_key": "QUEST_MINOR_BEWARE_THE_GOLD_LICH_2"
                        },
                        "$type": "OutwardArchipelago.Graphs.Actions.Action_CompleteLocationCheck"
                    },
                    {
                        "_location": {
                            "_key": "QUEST_MINOR_BEWARE_THE_GOLD_LICH_3"
                        },
                        "$type": "OutwardArchipelago.Graphs.Actions.Action_CompleteLocationCheck"
                    },
                    {
                        "_location": {
                            "_key": "QUEST_MINOR_BEWARE_THE_GOLD_LICH_4"
                        },
                        "$type": "OutwardArchipelago.Graphs.Actions.Action_CompleteLocationCheck"
                    }
                ],
                "$type": "NodeCanvas.Framework.ActionList"
            },
            "_position": {
                "x": 2415.0,
                "y": 2818.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "99"
        },
        {
            "_action": {
                "Sound": "LOC_EXCL_LichListen05",
                "TransPos": {},
                "$type": "NodeCanvas.Tasks.Actions.PlaySound"
            },
            "_position": {
                "x": 4785.0,
                "y": 6195.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "110"
        },
        {
            "statement": {
                "_text": "Enough! I will fight no more! You are an exceptional warrior, human. This damage will take days of work to repair.",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_15"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4710.0,
                "y": 6285.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "113"
        },
        {
            "statement": {
                "_text": "But know this, though you have delayed my work, you have not stopped me. I am an immortal lich. The phylactery that maintains my immortality is hidden safely from humankind. You can not slay me, no matter how hard you try!",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_16"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4785.0,
                "y": 6390.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "115"
        },
        {
            "statement": {
                "_text": "Go on, then. Leave with your precious little victory! When my injuries have been repaired, my work to save this world from the Corruption will resume once again!",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_17"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4695.0,
                "y": 6525.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "117"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "Then I\u2019ll just come back in a few days and beat you down again.",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_a_17"
                    }
                },
                {
                    "statement": {
                        "_text": "So you\u2019re saying I just have to come back in a few days to stop you again? Ok, sure.",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_b_17"
                    }
                },
                {
                    "statement": {
                        "_text": "Same time next week, then? We can do this for years, you know.",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_c_17"
                    }
                }
            ],
            "_position": {
                "x": 4815.0,
                "y": 6645.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "119"
        },
        {
            "_action": {
                "Sound": "LOC_EXCL_LichListen06",
                "TransPos": {},
                "$type": "NodeCanvas.Tasks.Actions.PlaySound"
            },
            "_position": {
                "x": 4815.0,
                "y": 6840.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "127"
        },
        {
            "statement": {
                "_text": "What? You\u2019d...Come back again and again just to keep me beaten down?! You monstrous, inhuman beast! Is your thirst for violence endless?",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_18"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4725.0,
                "y": 6930.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "130"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "I beat you once, I can do it again. Or you can just stop what you\u2019re doing and make this all go away.",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_a_18"
                    }
                },
                {
                    "statement": {
                        "_text": "I don\u2019t want to, but if you\u2019re going to keep planning to mess with my people, so help me I will!",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_b_18"
                    }
                },
                {
                    "statement": {
                        "_text": "Who\u2019s the monstrous one, again? I\u2019m going to enjoy taking you apart over and over!",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_c_18"
                    }
                }
            ],
            "_position": {
                "x": 4830.0,
                "y": 7035.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "132"
        },
        {
            "statement": {
                "_text": "An endless circle of violence? This benefits neither of us. I have a counter-proposal, human. I will cease my work until your life has ended. If that is not enough, I have material wealth I can provide to buy your peace.",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_19"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4770.0,
                "y": 7230.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "140"
        },
        {
            "statement": {
                "_text": "This spire is a vast collection tool for rare resources. Return every week, and I shall share with you some of the bounty of minerals and rare ores it provides me, and I can prove to you that my work has ceased. In this way, no further pointless violence is needed.",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_20"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4770.0,
                "y": 7350.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "142"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "Alright. But if I catch even one whiff that you\u2019re working to harm humanity again...",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_a_20"
                    }
                },
                {
                    "statement": {
                        "_text": "Deal. You\u2019d better keep your end of the bargain, lich!",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_b_20"
                    }
                },
                {
                    "statement": {
                        "_text": "Ah, now we\u2019re talking. I\u2019m glad we could come to a reasonable arrangement.",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_c_20"
                    }
                }
            ],
            "_position": {
                "x": 4860.0,
                "y": 7470.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "144"
        },
        {
            "_action": {
                "Sound": "LOC_EXCL_LichListen05",
                "TransPos": {},
                "$type": "NodeCanvas.Tasks.Actions.PlaySound"
            },
            "_position": {
                "x": 4890.0,
                "y": 7695.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "152"
        },
        {
            "statement": {
                "_text": "You can trust my word. A delay of a few decades means nothing to one who is immortal. I may not be pleased with this turn of events, but I have more to lose if I break my word to you. I am glad we could find a more efficient use of our time.",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_21"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4770.0,
                "y": 7815.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "155"
        },
        {
            "statement": {
                "_text": "Here, as a show of good faith, you may have your first peace payment. You may choose to take 3 of these rare materials with you. Then, I expect you to leave me be!",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_22"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4770.0,
                "y": 7965.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "157"
