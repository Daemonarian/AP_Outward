            },
            "_position": {
                "x": 3795.0,
                "y": 5805.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "37"
        },
        {
            "statement": {
                "_text": "Approach the sphere of your choice, and I shall tell you what it contains, and offer you the bounty within. You may choose 3 times before the spire\u2019s power is spent.",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_31"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3645.0,
                "y": 5910.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "40"
        },
        {
            "_position": {
                "x": 3750.0,
                "y": 6075.0
            },
            "$type": "NodeCanvas.DialogueTrees.FinishNode",
            "$id": "42"
        },
        {
            "_condition": {
                "QuestEventRef": {
                    "m_eventUID": "Gk0Q82pynUSG8AA5sZHBkA"
                },
                "$type": "NodeCanvas.Tasks.Conditions.Condition_QuestEventOccured"
