            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "28"
        },
        {
            "statement": {
                "_text": "It is not yet time for the next payment, human. Return once a week has passed. If this is about my work, rest assured that I have not pursued it. I have no interest in breaking our agreement and being subjected to your violence once again.",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_32"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3375.0,
                "y": 5700.0
            },
