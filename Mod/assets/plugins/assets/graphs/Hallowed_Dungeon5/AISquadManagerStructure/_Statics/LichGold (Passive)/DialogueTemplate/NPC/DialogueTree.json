                "x": 4200.0,
                "y": 5880.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "46"
        },
        {
            "statement": {
                "_text": "You are here for your next payment, human?",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_23"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4140.0,
                "y": 5955.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "49"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "Yes. Hand it over.",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_a_23"
                    }
                },
                {
                    "statement": {
                        "_text": "I want Tsar Stone, I don\u2019t see any here!",
                        "_meta": "Player_HallowedMarsh_SQ_LightMenderLich_b_23"
                    }
                },
                {
                    "statement": {
                        "_text": "So, what do you do with your time now?",
                        "_meta": "HallowedMarsh_SQ_LightMenderLich_27"
                    }
                },
                {
                    "statement": {
                        "_text": "I\u2019m leaving.",
                        "_meta": "Merchant_Generic_Leave_01"
                    }
                }
            ],
            "_position": {
                "x": 4110.0,
                "y": 6075.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "51"
        },
        {
            "_action": {
                "Sound": "LOC_EXCL_LichListen05",
                "TransPos": {},
                "$type": "NodeCanvas.Tasks.Actions.PlaySound"
            },
            "_position": {
                "x": 3735.0,
                "y": 6285.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "61"
        },
        {
            "statement": {
                "_text": "Here, you may choose 3 of these rare materials. Then leave me in peace!",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_24"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3570.0,
                "y": 6390.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "64"
        },
        {
            "_action": {
                "QuestEventRef": {
                    "m_eventUID": "6-JZRVaap0ife9PpGOc45A"
                },
                "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
            },
            "_position": {
                "x": 3630.0,
                "y": 6555.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "66"
        },
        {
            "_position": {
                "x": 3660.0,
                "y": 6645.0
            },
            "$type": "NodeCanvas.DialogueTrees.FinishNode",
            "$id": "69"
        },
        {
            "_action": {
                "Sound": "LOC_EXCL_LichListen05",
                "TransPos": {},
                "$type": "NodeCanvas.Tasks.Actions.PlaySound"
            },
            "_position": {
                "x": 3990.0,
                "y": 6315.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "70"
        },
        {
            "statement": {
                "_text": "You ask for the impossible. Even with all the power in this spire, it would take centuries to create even a single one, and to collect one would be nearly as hard. No, you will have to be satisfied with what I offer.",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_25"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3945.0,
                "y": 6420.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "73"
        },
        {
            "_targetNode": {
                "$ref": "51"
            },
            "_position": {
                "x": 4065.0,
                "y": 6525.0
            },
            "$type": "NodeCanvas.DialogueTrees.GoToNode",
            "$id": "75"
        },
        {
            "_action": {
                "Sound": "LOC_EXCL_LichListen05",
                "TransPos": {},
                "$type": "NodeCanvas.Tasks.Actions.PlaySound"
            },
            "_position": {
                "x": 4290.0,
                "y": 6330.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "76"
        },
        {
            "statement": {
                "_text": "I have returned to my old studies on mechanical creations. If I cannot continue with my intended plans, I can at least continue to perfect my means of opposing the Scourge.",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_28"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4290.0,
                "y": 6435.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "79"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "If one of your golems takes a swipe at me, I\u2019m going to break it. You realize that, right?",
                        "_meta": "HallowedMarsh_SQ_LightMenderLich_29"
                    }
                }
            ],
            "_position": {
                "x": 4365.0,
                "y": 6555.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "81"
        },
        {
            "statement": {
                "_text": "They are designed to be broken. How else could I test their efficiency in combat?",
                "_meta": "HallowedMarsh_SQ_LightMenderLich_30"
            },
            "_actorName": "name_unpc_GoldLich_01",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4230.0,
                "y": 6660.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "85"
        },
        {
            "_targetNode": {
                "$ref": "51"
            },
            "_position": {
                "x": 4365.0,
                "y": 6795.0
            },
            "$type": "NodeCanvas.DialogueTrees.GoToNode",
            "$id": "87"
        },
        {
            "_position": {
                "x": 4470.0,
                "y": 6255.0
            },
            "$type": "NodeCanvas.DialogueTrees.FinishNode",
            "$id": "88"
        },
        {
            "_action": {
                "actions": [
                    {
                        "QuestEventRef": {
                            "m_eventUID": "Gk0Q82pynUSG8AA5sZHBkA"
