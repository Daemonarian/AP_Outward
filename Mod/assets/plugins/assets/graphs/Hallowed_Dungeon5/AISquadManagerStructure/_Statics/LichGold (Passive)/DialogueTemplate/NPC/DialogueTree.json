            "_position": {
                "x": 4290.0,
                "y": 5790.0
            },
            "$type": "NodeCanvas.DialogueTrees.ConditionNode",
            "$id": "43"
        },
        {
            "_action": {
                "Sound": "LOC_EXCL_LichListen06",
                "TransPos": {},
