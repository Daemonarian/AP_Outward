            },
            "_position": {
                "x": 4245.0,
                "y": 4695.0
            },
            "$type": "NodeCanvas.DialogueTrees.ActionNode",
            "$id": "60"
        },
        {
            "statement": {
                "_text": "Unless you have big news or we\u2019re under attack or you\u2019re here to drink with me, I don\u2019t think I have much to say to you. Free time is hard to come by for a Chamberlord of such a big city and intend to enjoy every moment I can snatch.",
                "_meta": "Sagard_BC_Prequest_07"
            },
            "_actorName": "name_unpc_sagardbattleborn_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4200.0,
                "y": 3570.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "67"
        },
        {
            "$ref": "18"
        },
        {
            "_position": {
                "x": 4515.0,
                "y": 3915.0
            },
            "$type": "NodeCanvas.DialogueTrees.FinishNode",
            "$id": "69"
        },
        {
            "statement": {
                "_text": "If you pay me, sure, I\u2019ll give you a private lesson. You wanna know the most effective way to finish off a opponent with a 2-handed axe once you\u2019ve got them on the floor? Pay my tab for tonight, about 50 silver, and I\u2019ll teach you.",
                "_meta": "Trainer_Micro_Finisher_01"
            },
            "_actorName": "name_unpc_sagardbattleborn_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 5160.0,
                "y": 3960.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "70"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "Deal, here\u2019s your money.",
                        "_meta": "Merchant_Generic_Pay_01"
                    },
                    "condition": {
                        "character": {
                            "_name": "gInstigator",
                            "_targetVariableID": "0483cf6b-da62-4a57-aaed-40f25b4bdf9b"
                        },
                        "item": {
                            "_value": {
                                "m_itemID": 9000010
                            }
                        },
                        "minAmount": {
                            "_value": 50
                        },
                        "itemMustBeEquiped": {},
                        "$type": "NodeCanvas.Tasks.Conditions.Condition_OwnsItem"
                    }
                },
                {
                    "statement": {
                        "_text": "No, thanks.",
                        "_meta": "Merchant_Generic_No_02"
                    }
                }
            ],
            "_position": {
                "x": 5190.0,
                "y": 4095.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "72"
        },
        {
            "statement": {
                "_text": "Alright, come with me. We\u2019re going to go practice this on a couple of old logs. Here, I\u2019ll even let you use my-",
                "_meta": "Trainer_Micro_Finisher_02"
            },
            "_actorName": "name_unpc_sagardbattleborn_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
