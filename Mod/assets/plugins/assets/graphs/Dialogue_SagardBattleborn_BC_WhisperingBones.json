        },
        {
            "_action": {
                "actions": [
                    {
                        "QuestEventRef": {
                            "m_eventUID": "ft8ICwXzBESOrn78N1N3ww"
                        },
                        "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
                    },
                    {
                        "QuestEventRef": {
                            "m_eventUID": "uKt6piKIsUCOle_AD9PNtg"
                        },
                        "$type": "NodeCanvas.Tasks.Actions.SendQuestEvent"
