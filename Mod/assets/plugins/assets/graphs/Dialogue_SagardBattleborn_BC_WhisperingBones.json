                "y": 3570.0
            },
            "$type": "NodeCanvas.DialogueTrees.ConditionNode",
            "$id": "12"
        },
        {
            "statement": {
                "_text": "Seriously, what is going on in my damn city?! Why is no one giving me a damn straight answer?!",
                "_meta": "Sagard_BC_Bones_05"
            },
            "_actorName": "name_unpc_sagardbattleborn_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3330.0,
                "y": 4260.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "15"
        },
        {
            "_targetNode": {
                "availableChoices": [
                    {
                        "statement": {
                            "_text": "Farewell.",
                            "_meta": "Merchant_Generic_Farewell_01"
                        }
                    },
                    {
                        "statement": {
                            "_text": "I want to train with you.",
                            "_meta": "Merchant_Generic_Train_01"
                        },
                        "condition": {
                            "_location": {
                                "_key": "TRAIN_SAGARD_BATTLEBORN"
                            },
                            "_invert": true,
                            "$type": "OutwardArchipelago.Graphs.Conditions.Condition_LocationCheck"
                        }
                    }
                ],
                "_position": {
                    "x": 4830.0,
                    "y": 3675.0
                },
                "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
                "$id": "18"
            },
            "_position": {
                "x": 3765.0,
                "y": 4935.0
            },
            "$type": "NodeCanvas.DialogueTrees.GoToNode",
            "$id": "17"
        },
        {
            "statement": {
                "_text": "Oy, you! Yes, you! Go fetch Rissa! One of her idiots just tried to stab me!",
                "_meta": "Sagard_BC_Bones_01"
            },
            "_actorName": "name_unpc_sagardbattleborn_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3690.0,
                "y": 3720.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "26"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "Is that Julius's corpse behind you? What happened here?",
                        "_meta": "Player_Sagard_BC_Bones_a_01"
                    }
                }
            ],
            "_position": {
                "x": 3825.0,
                "y": 3810.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "28"
        },
        {
            "statement": {
                "_text": "He was talking with a girl in red, and it turned into an argument. She was telling him that there was something she needed to do, and he was refusing, telling her that he wouldn't let her \"throw her life away\". ",
                "_meta": "Sagard_BC_Bones_02"
            },
            "_actorName": "Sagard Battleborn",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3885.0,
                "y": 3930.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "32"
        },
        {
            "statement": {
                "_text": "Then she said <color=#FF0000><b>\"If I don't get into that necropolis, my mistress will kill me\"</b></color>, and I decided it might be a good idea to them ask a few questions.",
                "_meta": "Sagard_BC_Bones_06"
            },
            "_actorName": "Sagard Battleborn",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3990.0,
                "y": 4050.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "34"
        },
        {
            "statement": {
                "_text": "That's when your friend over there decided to try to take me with a dagger, and the girl grabbed something off his belt and bolted for the door!",
                "_meta": "Sagard_BC_Bones_03"
            },
            "_actorName": "Sagard Battleborn",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 3915.0,
                "y": 4155.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "36"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "Julius, you idiot. This sounds like the oldest story in the book.",
                        "_meta": "Player_Sagard_BC_Bones_a_03"
                    }
                }
            ],
            "_position": {
                "x": 4050.0,
                "y": 4245.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "38"
        },
        {
            "statement": {
                "_text": "What are you blabbering about? One of Rissa\u2019s goons tries to murder me and you\u2019re concerned about the girl that ran instead?!",
                "_meta": "Sagard_BC_Bones_04"
            },
            "_actorName": "name_unpc_sagardbattleborn_01 ",
            "_actorParameterID": "40fbaef3-4bf8-4bc9-bf2f-ae0d25ded760",
            "_position": {
                "x": 4020.0,
                "y": 4335.0
            },
            "$type": "NodeCanvas.DialogueTrees.StatementNodeExt",
            "$id": "42"
        },
        {
            "availableChoices": [
                {
                    "statement": {
                        "_text": "You'll have to go get Rissa yourself. I need to catch up with that woman before she breaks something important in the necropolis.",
                        "_meta": "Player_Sagard_BC_Bones_a_04"
                    }
                }
            ],
            "_position": {
                "x": 4140.0,
                "y": 4455.0
            },
            "$type": "NodeCanvas.DialogueTrees.MultipleChoiceNodeExt",
            "$id": "44"
        },
        {
            "_condition": {
                "QuestEventRef": {
                    "m_eventUID": "5NfRrLWmaUqlWrev4DCIYg"
                },
                "ExpiryTime": 960,
                "$type": "NodeCanvas.Tasks.Conditions.Condition_CheckQuestEventExpiry"
