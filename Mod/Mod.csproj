<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{3d6aff82-c4e4-4757-a835-13a5bf191ade}</ProjectGuid>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>OutwardArchipelago</AssemblyName>
    <RootNamespace>OutwardArchipelago</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <VersionFile>$(ProjectDir)..\version.json</VersionFile>
    <CodeGenExe>..\Mod.CodeGen\bin\$(Configuration)\net10.0\OutwardArchipelago.CodeGen.exe</CodeGenExe>
    <ConfluxExe>..\Tools\Conflux\bin\$(Configuration)\net10.0\Conflux.exe</ConfluxExe>
    <ModName>OutwardArchipelago</ModName>
    <ModAssetsDir>assets\</ModAssetsDir>
    <ModManifestFile>$(ModAssetsDir)manifest.json</ModManifestFile>
  </PropertyGroup>
  <PropertyGroup>
    <OutwardHomeDir>C:\Program Files (x86)\Steam\steamapps\common\Outward\Outward_Defed</OutwardHomeDir>
    <R2ModManProfileDir>C:\Users\User\AppData\Roaming\r2modmanPlus-local\OutwardDe\profiles\AP_Outward</R2ModManProfileDir>
    <ModFolderName>daemonarian-$(ModName)</ModFolderName>
    <CopyModOnBuild>false</CopyModOnBuild>
    <ModLoggingDumpOutwardObjects>false</ModLoggingDumpOutwardObjects>
  </PropertyGroup>
  <Import Project="user.props" Condition="Exists('user.props')" />
  <PropertyGroup Condition="'$(ModLoggingDumpOutwardObjects)' == 'true'">
    <DefineConstants>$(DefineConstants);MOD_LOGGING_DUMP_OUTWARD_OBJECTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="build\**" />
    <EmbeddedResource Remove="build\**" />
    <None Remove="build\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="app.config" />
    <None Remove="nuget.config" />
    <None Remove="user.props" />
    <None Remove="user.props.template" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.0" />
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.19" />
    <PackageReference Include="HarmonyX" Version="2.5.7" />
    <PackageReference Include="Outward.GameLibs" Version="2022.5.18-r.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2020.3.26" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mod.CodeGen\Mod.CodeGen.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\Tools\Conflux\Conflux.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SideLoader">
      <HintPath>..\External\Libraries\SideLoader.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ModSharedFiles Include="..\README.md" />
    <ModSharedFiles Include="..\CHANGELOG.md" />
    <ModAssetFiles Include="$(ModAssetsDir)**\*.*" Exclude="$(ModManifestFile)" />
    <ConfluxScripts Include="Conflux\*.yaml" />
  </ItemGroup>
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -Command &quot;(Get-Content -Path '$(VersionFile)' | ConvertFrom-Json).version&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="Version" />
    </Exec>
    <PropertyGroup>
      <GeneratedCode>
        namespace OutwardArchipelago %7B
            public static class BuildInfo %7B
                public const string ModVersion = "$(Version)"%3B
            %7D
        %7D
      </GeneratedCode>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.cs" Lines="$(GeneratedCode)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.cs" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateAPWorldBindings" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <CodeGenOutput>$(IntermediateOutputPath)APWorld.gen.cs</CodeGenOutput>
    </PropertyGroup>
    <Exec Command="&quot;$(CodeGenExe)&quot; --output &quot;$(CodeGenOutput)&quot; --namespace &quot;$(RootNamespace).Archipelago&quot; --class &quot;APWorld&quot; --access-modifier &quot;internal&quot;" />
    <ItemGroup>
      <Compile Include="$(CodeGenOutput)" />
    </ItemGroup>
  </Target>
  <Target Name="StageMod" AfterTargets="Build" DependsOnTargets="StageModBinaries;StageModAssets;StageModSharedFiles;StageModManifest;StageModConfluxScripts" />
  <Target Name="StageModBinaries" DependsOnTargets="Build">
    <ItemGroup>
      <PackageDllFiles Include="$(OutputPath)OutwardArchipelago.dll" />
      <PackageDllFiles Include="$(OutputPath)Archipelago.MultiClient.Net.dll" />
      <PackageDllFiles Include="$(OutputPath)Newtonsoft.Json.dll" />
      <PackageDllFiles Include="$(OutputPath)OutwardArchipelago.pdb" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageDllFiles)" DestinationFolder="$(OutputPath)staging\plugins" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="StageModAssets" Inputs="@(ModAssetFiles)" Outputs="@(ModAssetFiles->'$(OutputPath)staging\%(RecursiveDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(ModAssetFiles)" DestinationFiles="@(ModAssetFiles->'$(OutputPath)staging\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="StageModSharedFiles" Inputs="@(ModSharedFiles)" Outputs="@(ModSharedFiles->'$(OutputPath)staging\%(Filename)%(Extension)')">
    <Copy SourceFiles="@(ModSharedFiles)" DestinationFiles="@(ModSharedFiles->'$(OutputPath)staging\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="StageModManifest" Inputs="$(VersionFile);$(ModManifestFile)" Outputs="$(OutputPath)staging\manifest.json">
    <Exec Command="powershell -NoProfile -Command &quot;(Get-Content -Path '$(VersionFile)' | ConvertFrom-Json).version&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="Version" />
    </Exec>
    <PropertyGroup>
      <PackageManifestContent>$([System.IO.File]::ReadAllText('$(ModManifestFile)'))</PackageManifestContent>
      <NewPackageManifestContent>$(PackageManifestContent.Replace('{{MOD_VERSION}}', '$(Version)'))</NewPackageManifestContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutputPath)staging\manifest.json" Lines="$(NewPackageManifestContent)" Overwrite="true" />
  </Target>
  <Target Name="StageModConfluxScripts" Inputs="$(ConfluxExe);@(ConfluxScripts)" Outputs="$(OutputPath)staging\plugins\graphs\%(ConfluxScripts.Filename).json">
    <MakeDir Directories="$(OutputPath)staging\plugins\graphs\" />
    <Exec Command="&quot;$(ConfluxExe)&quot; --input &quot;%(ConfluxScripts.FullPath)&quot; --output &quot;$(OutputPath)staging\plugins\graphs\%(ConfluxScripts.Filename).json&quot; --format Template" />
  </Target>
  <Target Name="InstallModLocally" AfterTargets="Build" DependsOnTargets="StageMod" Condition="$(CopyModOnBuild)">
    <PropertyGroup>
      <ModDir>$(R2ModManProfileDir)\BepInEx\plugins\$(ModFolderName)</ModDir>
    </PropertyGroup>
    <ItemGroup>
      <_StagedRootFiles Include="$(OutputPath)staging\*.*" />
      <_StagedPluginFiles Include="$(OutputPath)staging\plugins\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(ModDir)" />
    <MakeDir Directories="$(ModDir)" />
    <Copy SourceFiles="@(_StagedRootFiles)" DestinationFiles="@(_StagedRootFiles->'$(ModDir)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_StagedPluginFiles)" DestinationFiles="@(_StagedPluginFiles->'$(ModDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="OverwriteLaunchSettings" AfterTargets="Build" Condition="$(CopyModOnBuild)">
    <PropertyGroup>
      <GeneratedLaunchSettings>
        %7B
          "profiles": %7B
            "Outward": %7B
              "commandName": "Executable",
              "executablePath": "$(OutwardHomeDir.Replace('\', '\\'))\\Outward Definitive Edition.exe",
              "commandLineArgs": "--doorstop-enable true --doorstop-target \"$(R2ModManProfileDir.Replace('\', '\\'))\\BepInEx\\core\\BepInEx.Preloader.dll\"",
              "workingDirectory": "$(R2ModManProfileDir.Replace('\', '\\'))"
            %7D
          %7D
        %7D
      </GeneratedLaunchSettings>
    </PropertyGroup>
    <WriteLinesToFile File="Properties\launchSettings.json" Lines="$(GeneratedLaunchSettings)" Overwrite="true" />
    <WriteLinesToFile File="$(OutwardHomeDir)\steam_appid.txt" Lines="794260" Overwrite="true" />
  </Target>
</Project>