<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <Target Name="CopyBinariesToExtension" AfterTargets="Build">
    <ItemGroup>
      <BuildOutputs Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Message Text="Copying CLI binaries to VS Code extension..." Importance="high" />
    <Copy SourceFiles="@(BuildOutputs)" DestinationFolder="..\NodeCanvas.LivePreview\bin\%(RecursiveDir)" />
  </Target>

</Project>
